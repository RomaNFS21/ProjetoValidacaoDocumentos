# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PROJETO VALIDAÇÃO AUTOMÁTICA DE DOCUMENTOS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR / APLICAÇÃO (SPRING BOOT)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (POSTGRESQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=doc_validation_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# ------------------------------------------------------------------------------
# 3. TESSERACT OCR (VISÃO COMPUTACIONAL & OCR)
# ------------------------------------------------------------------------------
# No Windows, após instalar o Tesseract (via winget ou instalador oficial),
# aponte para o diretório tessdata que contém o modelo de português (por.traineddata):
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGUAGE=por

# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (SPRING AI)
# ------------------------------------------------------------------------------
# Escolha o provedor de IA preferido: OpenAI ou Google Gemini

# Opção A: OpenAI (GPT-4o-mini ou GPT-4o)
OPENAI_API_KEY=sua-chave-openai-aqui
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-4o-mini

# Opção B: Google Gemini (Gemini 1.5 Flash)
GEMINI_API_KEY=sua-chave-gemini-aqui
SPRING_AI_GEMINI_CHAT_OPTIONS_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 5. FRONTEND (VITE / REACT)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
